--- a/integrasi_sensor/config.example.env
+++ b/integrasi_sensor/config.example.env
@@ -0,0 +1,26 @@
+# Salin ke integrasi_sensor/config.env bila ingin konfigurasi khusus.
+# Semua variabel opsional (ada default di kode). Nilai di .env root juga dibaca.
+#
+# --- Broker MQTT (Mosquitto) ---
+MQTT_HOST=127.0.0.1
+MQTT_PORT=1883
+# Kosongkan bila broker memakai allow_anonymous
+MQTT_USER=
+MQTT_PASSWORD=
+#
+# --- Publisher (perangkat kiosk) ---
+DEVICE_ID=kiosk-01
+MQTT_TOPIC_PREFIX=measlescare
+SUHU_SAMPLES=5
+RFID_DEBOUNCE_SEC=2
+I2C_BUS=1
+SPI_BUS=0
+SPI_DEVICE=0
+SPI_SPEED=1000000
+#
+# --- Bridge (subscriber -> database) ---
+MQTT_SUBSCRIBE_TOPIC=measlescare/+/reading
+SUHU_MIN=25.0
+SUHU_MAX=45.0
+# Bila perlu override; default dibaca dari DATABASE_URL di .env root backend
+# DATABASE_URL=mysql+pymysql://root:***@127.0.0.1:3306/db_huawei