--- a/docker-compose.yml
+++ b/docker-compose.yml
@@ -40,5 +40,26 @@
       - ./process-recognation:/app/process-recognation
     mem_limit: 512m
 
+  # Broker MQTT untuk integrasi sensor (MLX90614 + MFRC522).
+  # Publisher/bridge: integrasi_sensor/ (lihat integrasi_sensor/README.md).
+  mosquitto:
+    image: eclipse-mosquitto:2
+    container_name: huawei-mosquitto
+    restart: unless-stopped
+    ports:
+      - "1883:1883"
+    volumes:
+      - ./mosquitto/config:/mosquitto/config:ro
+      - mosquitto_data:/mosquitto/data
+      - mosquitto_log:/mosquitto/log
+    healthcheck:
+      test: ["CMD-SHELL", "mosquitto_sub -h 127.0.0.1 -p 1883 -t '$$SYS/broker/uptime' -C 1 -W 5 >/dev/null 2>&1 || exit 1"]
+      interval: 10s
+      timeout: 5s
+      retries: 5
+    mem_limit: 128m
+
 volumes:
   db_data:
+  mosquitto_data:
+  mosquitto_log:
